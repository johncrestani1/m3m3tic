m3m3tic:
  version: "0.2.0"
  created_at: "2026-05-17T00:00:00Z"
  generator:
    tool: "Bonfire Terminal"
    version: "2.7.246"

entity:
  legal_name: "Bluehost Inc."
  brand_name: "Bluehost"
  domain: "bluehost.com"
  jurisdiction: "US"
  operating_jurisdictions: ["US", "GB", "CA", "AU", "IN"]
  industry:
    iab_content_taxonomy_id: "596"   # Technology & Computing
    iab_ad_product_taxonomy_id: "1082"  # Computer Software

brand:
  voice:
    personality: "Approachable, technically competent, solution-oriented. Helps beginners feel confident."
    primary_tone: "helpful"
    secondary_tones: ["approachable", "confident"]
    avoided_tones: ["condescending", "overly technical", "salesy"]
    formality_level: "medium"
    uses_contractions: true
    good_examples:
      - "Get your website online in under 5 minutes."
      - "Free domain name included with every plan."
      - "24/7 support from real humans."
    bad_examples:
      - "YOU NEED A WEBSITE NOW OR YOUR BUSINESS WILL FAIL!"
      - "The absolute best hosting on the planet guaranteed!"
  terminology:
    preferred_terms:
      - { preferred: "web hosting", alternatives: ["server", "hosting service"] }
      - { preferred: "website builder", alternatives: ["site creator", "page builder"] }
    prohibited_terms:
      - { term: "100% uptime", reason: "no hosting guarantees 100% uptime" }
      - { term: "never goes down", reason: "unsubstantiable reliability claim" }
      - { term: "fastest hosting", reason: "superlative without evidence" }
      - { term: "unlimited everything", reason: "fair use policies apply" }
    brand_name_casing: "Bluehost"
  visual:
    primary_colors: ["#003087", "#FFFFFF"]
    secondary_colors: ["#0046BE", "#F5F5F5"]
    accent_colors: ["#00B2E2"]
  platform_config:
    meta:
      campaign:
        objectives_allowed: [OUTCOME_LEADS, OUTCOME_TRAFFIC]
        special_ad_categories: ["NONE"]
      creative:
        cta_allowed: [LEARN_MORE, SIGN_UP, GET_STARTED]
    google_ads:
      campaign:
        channel_types_allowed: [SEARCH, DISPLAY, DEMAND_GEN]

relationships:
  - actor_ref: "{{LARRY_CR3ST4N1_HASH}}"
    actor_name: "Larry"
    type: "affiliate"
    compensation:
      model: "flat_fee"
      currency: "USD"
      rate_per_signup: 65.00           # $65 per qualified signup
      cookie_duration_days: 90
      attribution: "last_click"
    authority:
      brand_voice: false
      spend: false
      create_assets: true
      comparative_claims: true         # can compare hosting providers
      live_video: true
      platforms: ["blog", "youtube", "twitter", "podcast"]
      operations:
        granted:
          - "organic_post.create"
          - "video.create"
          - "referral_link.generate"
          - "comparison_review.create"
        withheld:
          - "campaign.create"
          - "adcreative.create"
          - "spend.allocate"
      spend_ceiling_monthly: 0
    duration:
      start: "2024-06-01"
      end: null
      notice_days: 30
    provenance:
      contract_provider: "impact_radius"
      contract_template: "bluehost_affiliate_agreement"
    status: "active"

claims:
  performance:
    evidence_required: true
    approved_sources:
      - type: "third_party_benchmark"
        platforms: ["gtmetrix", "pingdom", "webpagetest"]
        max_age_days: 90
      - type: "personal_experience"
        requirements: ["active_account", "documented_test"]
    prohibited_without_evidence:
      - pattern: "fastest"
        always_prohibited: true
      - pattern: "99.9% uptime"
        unless: "citing official SLA document"

legal:
  jurisdictions:
    - id: "US"
      policy_packs: ["ftc-endorsement-2024.1"]
    - id: "GB"
      policy_packs: ["asa-cap-code-ed12"]
    - id: "CA"
      policy_packs: ["ca-competition-act-74.01"]
    - id: "AU"
      policy_packs: ["au-acl-section18", "au-aana-code-disclosure"]
    - id: "IN"
      policy_packs: ["in-ccpa-endorsement-2022"]

disclosures:
  platform_renderings:
    blog:
      affiliate_disclosure:
        method: "disclosure_block"
        position: "above_fold"
        text: "This post contains affiliate links. If you purchase hosting through my links, I earn a commission at no extra cost to you."
    youtube:
      affiliate_disclosure:
        method: "description_first_line"
        text: "Affiliate links below — I earn a commission on signups."
      branded_content:
        method: "paid_promotion_checkbox"
        api_field: "paidProductPlacementDetails.hasPaidProductPlacement"
        value: true
    podcast:
      affiliate_disclosure:
        method: "verbal"
        timing: "before_mention"
        script: "Quick note — Bluehost is an affiliate partner. Link in the show notes."

_signature:
  algorithm: "Ed25519"
  signed_at: "2026-05-17T00:00:00Z"
  signature: "base64:..."
