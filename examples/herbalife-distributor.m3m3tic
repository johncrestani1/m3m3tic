# ─────────────────────────────────────────────────────────
# DISCLOSURES — Platform-specific rendering
# ─────────────────────────────────────────────────────────
disclosures:
  platform_renderings:
    instagram:
      distributor_status:
        method: "caption_line"
        text: "Herbalife Independent Distributor"
        position: "bio_or_first_line"
      branded_content:
        method: "platform_toggle"
        api_field: "branded_content_sponsor_page_id"
        value: "{{brand.platform_config.meta.account.page_id}}"
      income_disclosure:
        method: "link_in_bio"
        url: "{{claims.income.approved_sources[0].url}}"
        required_when: "any_income_reference"
    youtube:
      distributor_status:
        method: "description_line"
        text: "I am an independent Herbalife Nutrition distributor."
        position: "first_line"
      income_disclosure:
        method: "description_link"
        url: "{{claims.income.approved_sources[0].url}}"
      branded_content:
        method: "paid_promotion_checkbox"
        api_field: "paidProductPlacementDetails.hasPaidProductPlacement"
        value: true
    tiktok:
      distributor_status:
        method: "bio_text"
        text: "Herbalife Independent Distributor"
      branded_content:
        method: "branded_content_toggle"
        api_field: "is_branded_content"
        value: true
    blog:
      distributor_status:
        method: "disclosure_block"
        position: "above_fold"
        text: "I am an independent Herbalife Nutrition distributor. Products sold through independent distributors."
      income_disclosure:
        method: "inline_link"
        text: "See Statement of Typical Distributor Earnings"
        url: "{{claims.income.approved_sources[0].url}}"
      health_disclaimer:
        method: "footer_block"
        text: "These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease."

  # Per-jurisdiction required text (evaluated by policy packs)
  jurisdiction_text:
    US: "Herbalife Independent Distributor"
    CA: "This product is a natural health product, not a drug."
    MX: "Distribuidor Independiente de Herbalife"
    GB: "Food supplement. Not a substitute for a varied diet."
    AU: "This product is not listed on the ARTG."
    DE: "Herbalife Unabhängiger Berater"
    FR: "Membre Indépendant Herbalife"
    JP: "ハーバライフ独立ディストリビューター"
    KR: "허벌라이프 독립 판매원"
    BR: "Distribuidor Independente Herbalife"
    CN: "康宝莱独立服务商"
    IN: "Herbalife Independent Distributor"

