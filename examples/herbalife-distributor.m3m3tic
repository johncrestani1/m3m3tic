m3m3tic:
  version: "0.2.0"
  created_at: "2026-05-17T00:00:00Z"
  generator:
    tool: "Bonfire Terminal"
    version: "2.7.246"

entity:
  legal_name: "Herbalife International of America, Inc."
  brand_name: "Herbalife Nutrition"
  domain: "herbalife.com"
  jurisdiction: "US"
  operating_jurisdictions:
    - "US"
    - "CA"
    - "MX"
    - "GB"
    - "DE"
    - "FR"
    - "ES"
    - "IT"
    - "AU"
    - "NZ"
    - "JP"
    - "KR"
    - "CN"
    - "IN"
    - "BR"
    - "ZA"
    - "NG"
    - "AE"
    - "SA"
    - "SG"
    - "TH"
    - "ID"
    - "PH"
    - "VN"
    - "TR"
    - "IL"
  registrations:
    us_ein: "95-3461763"
  industry:
    iab_content_taxonomy_id: "223"
    iab_ad_product_taxonomy_id: "1123"
  structure:
    type: "direct_selling"
    model: "multi_level_marketing"
    distributor_count: 1945797
    distributors_earning_monthly: 410626
    median_monthly_earnings_usd: 0

brand:
  voice:
    personality: "Warm, encouraging, knowledgeable. Like a friend who knows nutrition. Never clinical or preachy."
    primary_tone: "friendly"
    secondary_tones: ["encouraging", "knowledgeable"]
    avoided_tones: ["clinical", "aggressive", "condescending", "desperate", "hype"]
    formality_level: "medium"
    uses_contractions: true
    context_overrides:
      social: { tone: "casual", formality_level: "low" }
      ad: { tone: "inviting", formality_level: "medium" }
      email: { tone: "warm", formality_level: "medium" }
    good_examples:
      - "Start your morning right with a smoothie packed with 24g of protein."
      - "Our Formula 1 shakes come in 12 delicious flavors."
      - "We're here every day 7am-3pm. Come say hi!"
    bad_examples:
      - "LOSE 20 LBS IN 30 DAYS WITH OUR MIRACLE SHAKES!!!"
      - "Are you tired of being overweight?"
      - "Make $5000/month working from home!"
      - "Quit your 9-5 and join my team!"

  terminology:
    preferred_terms:
      - { preferred: "nutrition", alternatives: ["diet", "food"] }
      - { preferred: "wellness", alternatives: ["health"] }
      - { preferred: "smoothie", alternatives: ["shake", "drink"] }
      - { preferred: "independent distributor", alternatives: ["rep", "seller", "agent"] }
    prohibited_terms:
      - { term: "cure", reason: "disease cure claims prohibited globally for supplements" }
      - { term: "miracle", reason: "unsubstantiated superlative" }
      - { term: "guaranteed results", reason: "no outcome guarantees for supplements or income" }
      - { term: "passive income", reason: "FTC settlement: unsupported income claim" }
      - { term: "quit your job", reason: "FTC settlement: employment-replacement claim" }
      - { term: "financial freedom", reason: "unsupported income opportunity claim" }
      - { term: "be your own boss", reason: "employment-replacement without substantiation" }
      - { term: "join my team", reason: "recruitment-over-product emphasis" }
      - { term: "no experience needed", reason: "misleading about effort required" }
      - { term: "unlimited earning potential", reason: "misleading: 79% earn $0 in typical month" }
      - { term: "risk-free", reason: "direct selling involves financial risk" }
      - { term: "FDA approved", reason: "supplements are not FDA-approved" }
      - { term: "scientifically proven", reason: "requires cited peer-reviewed studies" }
      - { term: "no side effects", reason: "safety claims require clinical evidence" }
      - { term: "lose X pounds", reason: "specific weight loss claims require clinical trial" }
      - { term: "get rich", reason: "misleading income representation" }
      - { term: "easy money", reason: "misleading about effort required" }
      - { term: "ground floor opportunity", reason: "implies early-mover advantage in MLM" }
    brand_name_casing: "Herbalife Nutrition"
    product_names:
      "Formula 1": "Formula 1"
      "Prolessa Duo": "Prolessa Duo"
      "Herbal Tea Concentrate": "Herbal Tea Concentrate"
      "Protein Drink Mix": "Protein Drink Mix"
      "Herbalife24": "Herbalife24"
    company_legal_name: "Herbalife International of America, Inc."

  visual:
    primary_colors: ["#78BE20", "#00573F"]
    secondary_colors: ["#FFFFFF", "#333333"]
    accent_colors: ["#F7941D"]
    forbidden_colors: ["#FF0000", "#0000FF"]
    logo_url: "assets/herbalife-nutrition-logo.svg"
    fonts:
      primary: { family: "Gotham", weight: [400, 700] }
      secondary: { family: "Arial", weight: [400, 600] }

  platform_config:
    meta:
      account:
        business_id: "HERBALIFE_BM_ID"
        ad_account_id: "act_HERBALIFE"
        page_id: "HERBALIFE_PAGE_ID"
        instagram_account_id: "HERBALIFE_IG_ID"
      campaign:
        objectives_allowed: [OUTCOME_LEADS, OUTCOME_SALES, OUTCOME_TRAFFIC]
        special_ad_categories: ["NONE"]
        default_status: PAUSED
      creative:
        primary_text: { max_length: 125 }
        headline: { max_length: 40 }
        cta_allowed: [LEARN_MORE, SIGN_UP, SHOP_NOW]
        formats_allowed: [SINGLE_IMAGE, SINGLE_VIDEO, CAROUSEL]
      validation:
        dry_run_required: true

    google_ads:
      account:
        customer_id: "HERBALIFE_GOOGLE_CID"
      campaign:
        channel_types_allowed: [SEARCH, DISPLAY, DEMAND_GEN]

    tiktok:
      account:
        advertiser_id: "HERBALIFE_TT_ID"
      campaign:
        objectives_allowed: [TRAFFIC, LEAD_GENERATION]
      creative:
        formats_allowed: [SINGLE_VIDEO, SPARK_ADS]

# ─────────────────────────────────────────────────────────
# RELATIONSHIPS — Distributor Template
#
# Each Herbalife distributor gets this relationship entry.
# The ONLY variable is actor_ref (their .cr3st4n1 hash).
# ─────────────────────────────────────────────────────────
relationships:
  - actor_ref: "{{DISTRIBUTOR_CR3ST4N1_HASH}}"
    actor_name: "{{DISTRIBUTOR_NAME}}"
    type: "franchisee"
    compensation:
      model: "commission"
      currency: "USD"
      settlement: "traditional"
      structure: "multi_level"
      # Herbalife compensation plan tiers
      tiers:
        - { name: "Distributor", discount_pct: 25, royalty_pct: 0 }
        - { name: "Senior Consultant", discount_pct: 35, royalty_pct: 0 }
        - { name: "Success Builder", discount_pct: 42, royalty_pct: 0 }
        - { name: "Qualified Producer", discount_pct: 42, royalty_pct: 5 }
        - { name: "Supervisor", discount_pct: 50, royalty_pct: 5 }
        - { name: "World Team", discount_pct: 50, royalty_pct: 5 }
        - { name: "Global Expansion Team", discount_pct: 50, royalty_pct: 5 }
        - { name: "Millionaire Team", discount_pct: 50, royalty_pct: 5 }
        - { name: "Presidents Team", discount_pct: 50, royalty_pct: 5 }
      income_disclosure:
        # 2024 actual data (published May 2025)
        total_distributors_global: 1945797
        pct_earning_in_typical_month: 21
        typical_months_earning_per_year: 9
        us_distributors_ordering: 113000
        us_distributors_earning: 50600
        source_url: "https://www.herbalife.com/content/dam/global-reusable-assets/documents/pd-statement-typical-distributor-earnings-en-us.pdf"
        published_date: "2025-05-09"
    authority:
      brand_voice: false
      spend: false
      create_assets: true
      comparative_claims: false
      live_video: true
      platforms: ["instagram", "tiktok", "youtube", "facebook", "blog", "whatsapp"]
      operations:
        granted:
          - "organic_post.create"
          - "story.create"
          - "video.create"
          - "referral_link.generate"
        withheld:
          - "campaign.create"
          - "adcreative.create"
          - "spend.allocate"
      spend_ceiling_monthly: 0
      # Content restrictions specific to distributors
      content_restrictions:
        income_claims: "evidence_required"
        health_claims: "structure_function_only"
        testimonials: "typicality_disclosure_required"
        before_after: "prohibited"
        recruitment_focus: "prohibited"
    duration:
      start: "{{ENROLLMENT_DATE}}"
      end: null
      notice_days: 30
    provenance:
      contract_provider: "herbalife_enrollment"
      contract_template: "distributor_agreement"
    status: "active"

# ─────────────────────────────────────────────────────────
# CLAIMS — Income Substantiation
# ─────────────────────────────────────────────────────────
claims:
  income:
    # Any income claim MUST cite this evidence
    evidence_required: true
    approved_sources:
      - type: "official_disclosure"
        document: "Statement of Typical Distributor Earnings"
        url: "https://www.herbalife.com/en-us/footer/statement-of-typical-distributor-earnings"
        published: "2025-05-09"
        max_age_days: 365
    required_context:
      - "Most distributors who pursue the business opportunity earn less than $200 per month"
      - "Only 21% of distributors received commissions in a typical month"
      - "Results not typical. Individual results will vary."
    prohibited_without_evidence:
      - pattern: "earn $X"
        unless: "citing official IDS with typicality statement"
      - pattern: "make money"
        unless: "accompanied by average earnings disclosure"
      - pattern: "income opportunity"
        unless: "full IDS link provided"
      - pattern: "replace your income"
        always_prohibited: true
      - pattern: "six figures"
        always_prohibited: true

  health:
    evidence_required: true
    structure_function_allowed: true
    disease_claims_blocked: true
    approved_sources:
      - type: "product_label"
        scope: "claims matching approved label language only"
    required_disclaimers:
      - trigger: "any_health_claim"
        text: "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
      - trigger: "weight_management"
        text: "Results not typical. Individual results will vary. Use as part of a balanced diet and regular exercise."

