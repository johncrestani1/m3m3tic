m3m3tic:
  version: "0.2.0"

entity:
  name: "NovaCRM Inc."
  domain: "novacrm.io"
  jurisdiction: "US"
  operating_regions:
    - "US"
    - "GB"
    - "EU"
    - "AU"

brand:
  voice:
    tone: "confident"
    style: "clear"
    personality: "helpful"
  terminology:
    preferred:
      - term: "customers"
        instead_of: "users"
  visual:
    primary_color: "#6366F1"
    dark_color: "#0F172A"
  platform_config:
    meta:
      objectives:
        - "OUTCOME_LEADS"
        - "OUTCOME_TRAFFIC"
    google_ads:
      campaign_types:
        - "SEARCH"
        - "PERFORMANCE_MAX"

relationships:
  - actor_ref: "sha256:agency-credential-hash"
    type: "agency"
    authority:
      brand_voice: true
      spend: true
      spend_ceiling: "$100k/mo"
    duration:
      start: "2026-01-01"
      end: "2026-12-31"
  - actor_ref: "sha256:affiliate-credential-hash"
    type: "affiliate"
    compensation:
      model: "commission"
      rate: "20%"
    authority:
      brand_voice: false
      spend: false

legal:
  jurisdictions:
    - region: "US"
      policies:
        - "ftc-endorsement-2024.1"
    - region: "EU"
      policies:
        - "dsa"
        - "gdpr"
        - "ai-act"
    - region: "GB"
      policies:
        - "asa-cap-code"
    - region: "AU"
      policies:
        - "acl-section18"

disclosures:
  instagram:
    branded_content: true
  youtube:
    paid_promotion_checkbox: true
